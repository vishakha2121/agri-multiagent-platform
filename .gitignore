.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

