# 🔐 ENVIRONMENT VARIABLES (VERY IMPORTANT!)
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
!.env.example

# ============================================
# 🗄️ DATABASE
# ============================================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal
database/agrisense.db
database/*.db

# Backups
*.bak
*.backup
backups/*.sql
backups/*.dump

# ============================================
# 🔑 SECRETS & KEYS
# ============================================
*.pem
*.key
*.crt
*.p12
secrets/
credentials/
config/secret*

# ============================================
# 📊 LOGS
# ============================================
*.log
logs/
log/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# 🖥️ OPERATING SYSTEM
# ============================================
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================
# 💻 IDE / EDITORS
# ============================================
# JetBrains (PyCharm, WebStorm)
.idea/
*.iml
*.iws
*.ipr
out/

# VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*.swn
.vim/

# ============================================
# 🎨 DESIGN / ASSETS (Optional)
# ============================================
# Temporary design files
*.psd
*.ai
*.sketch
*.fig
*.xd

# But keep final exports
!*.svg
!*.png
!*.jpg
!*.jpeg

# ============================================
# 🧪 TESTING & COVERAGE
# ============================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Jest / Vitest
coverage/
.jest-cache/
.vitest-cache/

# ============================================
# 📦 DOCKER
# ============================================
*.pid
*.seed
*.pid.lock
docker-compose.override.yml

# ============================================
# 🐳 PYTHON SPECIFIC
# ============================================
# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# pytype
.pytype/

# Cython
cython_debug/

# Ruff
.ruff_cache/

# Black
.black_cache/

# ============================================
# 🍎 MISC
# ============================================
# Gemini API cache
.gemini/
gemini_cache/

# Application temp files
temp/
tmp/
*.tmp
*.temp

# Uploads
uploads/
media/
static/uploads/

# Distribution
dist/
build/
out/

# Cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ============================================
# ✅ KEEP THESE TRACKED (Even if ignored above)
# ============================================
!.env.example
!README.md
!LICENSE
!.gitignore
# ============================================
# 🐍 PYTHON / BACKEND
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
.python-version

# Pytest
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# Jupyter Notebook
.ipynb_checkpoints/

# PyCharm / VSCode
.idea/
.vscode/
*.swp
*.swo
*~

# ============================================
# ⚛️ NODE / FRONTEND
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
dist/
dist-ssr/
build/
*.local

